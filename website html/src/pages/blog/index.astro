---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const thumbVariant = (i: number) => `card-thumb-${(i % 3) + 1}`;
---

<Layout title="Reviews & Guides — Flyntix Media" description="No pay-to-play rankings, no fluff — just real testing and pricing breakdowns to help you pick the right tool.">
  <div class="page-header">
    <div class="section-eyebrow">Reviews & Guides</div>
    <h1>Honest AI & software breakdowns</h1>
    <p>No pay-to-play rankings, no fluff — just real testing and pricing breakdowns to help you pick the right tool.</p>
  </div>

  <section>
    <div class="container">
      <div class="content-grid">
        {posts.map((post, i) => (
          <a href={`/blog/${post.slug}`} class="content-card">
            <div class={`card-thumb ${thumbVariant(i)}`}>
              <span class="thumb-label">{post.data.tags[0] ?? post.data.cardTag}</span>
            </div>
            <div class="card-body">
              <div class="card-tag">{post.data.cardTag}</div>
              <div class="card-title">{post.data.title}</div>
              <div class="card-excerpt">{post.data.description}</div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>
